--- metadata
/* CTF 1.8 */

trace {
    major = 1;
    minor = 8;
    byte_order = le;
};

event {
    name = ev;
    fields := struct {
        floating_point {
            exp_dig = 8;
            mant_dig = 24;
            align = 4294967296;
        } v;
    };
};

--- @error
Invalid `align` attribute in floating point number field class: expecting a power of two which is at most 2147483648: align=4294967296
